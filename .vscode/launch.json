            "justMyCode": false,
            "env": {
                "LOCAL_RANK": "0",
            },
            "args": [
                "--data_path",
                "/home/mereur1/projects/ocl/ssl_nat_aug/ssl_tests/dino/data/imagenet",
                "--arch",
                "vit_small"
            ]   
        },
        {
            "name": "train.py",
            "type": "debugpy",
