    "version": "0.2.0",
    "configurations": [

        {
            "name": "hbird eval",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/dense_prediction/open-hummingbird-eval/eval.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "--model=dinov2_vits14",
                "--input-size=504",
                "--patch-size=14",
                "--embeddings-size=384",
                "--memory-size=-1",
                "--batch-size=64",
                "--num-workers=8",
                // "--use-faiss",
                "--data-dir=/home/mereur1/projects/ocl/ssl_nat_aug/dense_prediction/open-hummingbird-eval/data",
                "--save-features",
                "--out-dir=/home/mereur1/projects/ocl/ssl_nat_aug/dense_prediction/open-hummingbird-eval/outputs/debug/"
            ]
        },

        {
            "name": "train.py",
            "type": "debugpy",
            "request": "launch",
            "program": "train.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "--fast_dev_run",
                "--devices=1",
                "--num_workers=8"
            ]
        },
        {
            "name": "dino debugging",
            "type": "debugpy",
            "request": "launch",
            "program": "train.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "--fast_dev_run",
                "--devices=1",
                "--num_workers=8",
                "--method=dino",
                // "--natural_augmentation"
            ]
        },
        {
            "name": "pmsn debugging",
            "type": "debugpy",
            "request": "launch",
            "program": "train.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                // "--fast_dev_run",
                "--devices=1",
                "--num_workers=8",
                "--data_dir=../data/PetFace",
                "--method=pmsn",
                "--batch_size_per_device=128",
                "--limit_train_batches=0.01",
                "--max_epochs=1",
                "--natural_augmentation"
            ]
        }
    ]
}