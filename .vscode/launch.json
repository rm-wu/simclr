        },
        {
            "name": "pmsn debugging",
            "type": "debugpy",
            "request": "launch",
            "program": "train.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                // "--fast_dev_run",
                "--devices=1",
                "--num_workers=8",
                "--data_dir=../data/PetFace",
                "--method=pmsn",
